      "created": 1795024867871,
      "link": null,
      "locked": false,
      "text": "The project is built around a microservices architecture, where each component is\nresponsible for a specific part of the ETL process.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The project is built around a microservices architecture, where each component is responsible for a specific part of the ETL process.",
