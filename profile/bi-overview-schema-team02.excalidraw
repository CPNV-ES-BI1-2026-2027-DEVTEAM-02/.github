      "text": "## Introduction",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "## Introduction",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xMq6J5a8PEtLAZ9Y-KDNI",
      "type": "text",
      "x": -371.98571113824255,
      "y": 44.69383005677571,
      "width": 372.7313537597656,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9B",
      "roundness": null,
      "seed": 355313224,
      "version": 5,
      "versionNonce": 1491150027,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867851,
      "link": null,
      "locked": false,
      "text": "Welcome to the ETL Platform project!",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Welcome to the ETL Platform project!",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "p3mDjsYS3lcxiCQAyYAdd",
      "type": "text",
      "x": -579.1946497368754,
      "y": 89.69383005677571,
      "width": 787.1492309570312,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9C",
      "roundness": null,
      "seed": 1520222776,
      "version": 5,
      "versionNonce": 2093523301,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867862,
      "link": null,
      "locked": false,
      "text": "This project is an educational initiative designed to introduce students and\ndevelopers to modern software engineering practices through the development of\na real-world-inspired ETL (Extract, Transform, Load) platform.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This project is an educational initiative designed to introduce students and developers to modern software engineering practices through the development of a real-world-inspired ETL (Extract, Transform, Load) platform.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wAHNvBWRX99psVehFA17W",
      "type": "text",
      "x": -583.9707727837504,
      "y": 209.6938300567757,
      "width": 796.7014770507812,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9D",
      "roundness": null,
      "seed": 1009884488,
      "version": 5,
      "versionNonce": 177754987,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867864,
      "link": null,
      "locked": false,
      "text": "The project follows a microservices-based architecture, encouraging developers to\nexplore distributed systems, service communication, data processing, software\narchitecture, and collaborative development.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The project follows a microservices-based architecture, encouraging developers to explore distributed systems, service communication, data processing, software architecture, and collaborative development.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wzDGJCBd2Bm4g2_4FBlpQ",
      "type": "text",
      "x": -570.373757402891,
      "y": 329.6938300567757,
      "width": 769.5074462890625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9E",
      "roundness": null,
      "seed": 255310648,
      "version": 5,
      "versionNonce": 1213803717,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867866,
      "link": null,
      "locked": false,
      "text": "Its primary objective is not simply to build a functional application, but also to\nprovide a practical environment where developers can learn, experiment, make\nmistakes, and progressively develop their engineering skills.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Its primary objective is not simply to build a functional application, but also to provide a practical environment where developers can learn, experiment, make mistakes, and progressively develop their engineering skills.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "WLjE5F73OZx4uzI_tU-VK",
      "type": "text",
      "x": -294.66481117486364,
      "y": 474.6938300567757,
      "width": 218.0895538330078,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9F",
      "roundness": null,
      "seed": 1839117384,
      "version": 5,
      "versionNonce": 1722854923,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867867,
      "link": null,
      "locked": false,
      "text": "## About the Project",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "## About the Project",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "x7rHWzpmt6g84R-EiW5V6",
      "type": "text",
      "x": -265.57525734185583,
      "y": 544.6938300567757,
      "width": 159.9104461669922,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9G",
      "roundness": null,
      "seed": 1208718392,
      "version": 5,
      "versionNonce": 478235685,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867868,
      "link": null,
      "locked": false,
      "text": "ETL stands for:",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ETL stands for:",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "dkSDy4y6NM8Mf7z0AN7K1",
      "type": "text",
      "x": -457.56778816460974,
      "y": 614.6938300567757,
      "width": 543.8955078125,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9H",
      "roundness": null,
      "seed": 1062267720,
      "version": 5,
      "versionNonce": 1613018283,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867868,
      "link": null,
      "locked": false,
      "text": "Extract – Retrieve data from various external sources.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Extract – Retrieve data from various external sources.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mYrPylMntFdogavV44LPU",
      "type": "text",
      "x": -540.5752649712504,
      "y": 684.6938300567757,
      "width": 709.9104614257812,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9I",
      "roundness": null,
      "seed": 1258048824,
      "version": 5,
      "versionNonce": 690913157,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867868,
      "link": null,
      "locked": false,
      "text": "Transform – Process, normalize, validate, and enrich the extracted data.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Transform – Process, normalize, validate, and enrich the extracted data.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "t8HQVEqKXUli0681jIF38",
      "type": "text",
      "x": -473.9334803032816,
      "y": 754.6938300567757,
      "width": 576.6268920898438,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9J",
      "roundness": null,
      "seed": 732185160,
      "version": 5,
      "versionNonce": 647948107,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867868,
      "link": null,
      "locked": false,
      "text": "Load – Transfer the processed data into a target system.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Load – Transfer the processed data into a target system.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "xHT8OtBLNzCGRw_irUaeA",
      "type": "text",
      "x": -585.4110804009379,
      "y": 812.1938300567758,
      "width": 799.5820922851562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9K",
      "roundness": null,
      "seed": 23979576,
      "version": 5,
      "versionNonce": 1151223525,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867869,
      "link": null,
      "locked": false,
      "text": "The platform aims to demonstrate how an ETL workflow can be implemented using\nindependently developed and interconnected microservices.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The platform aims to demonstrate how an ETL workflow can be implemented using independently developed and interconnected microservices.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3UhkDWIq3vopzf_8s69Z_",
      "type": "text",
      "x": -581.1200342583597,
      "y": 907.1938300567758,
      "width": 791,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9L",
      "roundness": null,
      "seed": 24426824,
      "version": 5,
      "versionNonce": 276415979,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867870,
      "link": null,
      "locked": false,
      "text": "Each service has a dedicated responsibility and communicates with other services\nthrough well-defined interfaces.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each service has a dedicated responsibility and communicates with other services through well-defined interfaces.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "TRgjOiCBzvXc8BJMUFPhi",
      "type": "text",
      "x": -567.6573572564066,
      "y": 1002.1938300567758,
      "width": 764.0746459960938,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9M",
      "roundness": null,
      "seed": 138698552,
      "version": 5,
      "versionNonce": 559817285,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795517142470,
      "created": 1795024867871,
      "link": null,
      "locked": false,
      "text": "This approach provides an opportunity to understand how modern applications\nare designed, structured, developed, tested, and maintained.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This approach provides an opportunity to understand how modern applications are designed, structured, developed, tested, and maintained.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
